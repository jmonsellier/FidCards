# Copier vers keystore.properties (ignoré par git) après avoir créé le keystore :
#
#   keytool -genkeypair -v -keystore fidcards-release.jks -alias fidcards \
#     -keyalg RSA -keysize 4096 -validity 36500
#
# ⚠ Le keystore est l'objet le plus irréversible du projet (docs/PROJET.md §14).
# Le perdre interdit toute mise à jour des APK installés : chaque membre du foyer
# devrait désinstaller et PERDRE SES CARTES. À sauvegarder immédiatement hors du
# dépôt et hors de la machine (coffre de mots de passe + second support).
storeFile=fidcards-release.jks
storePassword=CHANGER-MOI
keyAlias=fidcards
keyPassword=CHANGER-MOI
